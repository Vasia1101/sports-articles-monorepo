generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SportsArticle {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  deletedAt DateTime?
  imageUrl  String?

  @@index([deletedAt])
}
